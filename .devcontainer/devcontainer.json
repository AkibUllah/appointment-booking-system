{
  "name": "appointment-booking-system",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "postCreateCommand": "cp -n .env.example .env; pip install --upgrade pip && pip install -e \"./backend[dev]\" && cd frontend && npm ci --no-audit --no-fund",
  "postStartCommand": "docker compose up -d --build && docker compose run --rm seed",
  "forwardPorts": [8080, 8000],
  "portsAttributes": {
    "8080": {
      "label": "Frontend (patient site + admin editor)",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "API docs (/docs)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
