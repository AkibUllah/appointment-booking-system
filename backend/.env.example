# Database: SQLite for local dev, Postgres in docker-compose
DATABASE_URL=sqlite:///./booking.db
# DATABASE_URL=postgresql+psycopg://booking:booking@db:5432/booking

# Shared secret for admin endpoints (send as X-Admin-Token). Change in any real deployment.
ADMIN_TOKEN=dev-admin-token

# Clinic timezone used for slot generation
CLINIC_TIMEZONE=Asia/Dhaka

# Booking policies
CANCEL_MIN_HOURS_BEFORE=2
RESCHEDULE_MIN_HOURS_BEFORE=2
MAX_RESCHEDULES=2
BOOKING_MIN_LEAD_MINUTES=30
BOOKING_MAX_DAYS_AHEAD=30

# Reminder scheduler (APScheduler). Notifications go to the console backend.
SCHEDULER_ENABLED=true
REMINDER_INTERVAL_SECONDS=60

# CORS origins for the frontend (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
